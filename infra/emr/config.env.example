# Copy to config.env (git-ignored) and edit: cp config.env.example config.env
AWS_REGION=us-east-1
BUCKET=my-recsys-bucket-change-me        # must be globally unique
CATEGORY=Movies_and_TV

# Check the newest emr-7.x / emr-8.x label in the EMR console
RELEASE_LABEL=emr-7.5.0
PRIMARY_INSTANCE_TYPE=m5.xlarge
CORE_INSTANCE_TYPE=r5.xlarge             # memory-optimised, good for ALS
CORE_INSTANCE_COUNT=2
USE_SPOT_FOR_CORE=false                  # true = ~60-70% cheaper, may be interrupted

# true: cluster terminates after the steps finish (recommended while learning)
AUTO_TERMINATE=true
IDLE_TIMEOUT_SECONDS=3600                # used when AUTO_TERMINATE=false

# Training parameters
SAMPLE_FRACTION=                         # empty = full data, e.g. 0.1 for 10%
ALS_RANK=32
ALS_MAX_ITER=10
ALS_REG_PARAM=0.1
